{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoifuture.com/schemas/aoi-content-intake/corpus-item.v0.json",
  "title": "aoi.content.corpus-item.v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["url", "title", "observed_at"],
  "properties": {
    "url": { "type": "string", "pattern": "^https://" },
    "title": { "type": "string", "minLength": 1 },
    "published_at": { "type": "string" },
    "observed_at": { "type": "string" },
    "source_feed": { "type": "string" },
    "language_hint": { "type": "string", "enum": ["ja", "en", "und"] },
    "canonical_host": { "type": "string" }
  }
}