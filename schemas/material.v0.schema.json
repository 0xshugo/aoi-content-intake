{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoifuture.com/schemas/aoi-content-intake/material.v0.json",
  "title": "aoi.content.material.v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["url", "first_seen_at", "used_in"],
  "properties": {
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "canonical_host": { "type": "string", "minLength": 1 },
    "first_seen_at": { "type": "string", "description": "ISO 8601 with offset, JST preferred" },
    "snapshot_ids": { "type": "array", "items": { "type": "string" } },
    "axis_matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["axis_id", "axis_slug", "matched_at"],
        "properties": {
          "axis_id": { "type": "integer" },
          "axis_slug": { "type": "string" },
          "rule": { "type": "string" },
          "matched_at": { "type": "string" }
        }
      }
    },
    "used_in": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["product", "date"],
        "properties": {
          "product": { "enum": ["dailynews", "news_edition", "context_axis"] },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "artifact_id": { "type": "string" }
        }
      }
    },
    "_internal": {
      "type": "object",
      "description": "Must strip before any writer-facing export",
      "additionalProperties": true
    }
  }
}